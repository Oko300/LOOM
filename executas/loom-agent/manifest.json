{
  "name": "loom-agent",
  "version": "1.0.4",
  "host_capabilities": ["llm.sample", "aps.kv"],
  "credentials": [
    {
      "id": "flowdev_token",
      "required": false,
      "sensitive": true
    }
  ],
  "tools": [
    { "name": "check_connection", "parameters": [], "timeout": 30 },
    { "name": "get_memory", "parameters": [], "timeout": 30 },
    { "name": "start_session", "parameters": [], "timeout": 90 },
    {
      "name": "chat",
      "parameters": [
        { "name": "message", "type": "string", "required": true },
        { "name": "conversationHistory", "type": "array", "required": false }
      ],
      "timeout": 60
    },
    {
      "name": "update_memory",
      "parameters": [
        { "name": "updates", "type": "object", "required": true }
      ],
      "timeout": 30
    },
    {
      "name": "end_session",
      "parameters": [
        { "name": "sessionNote", "type": "string", "required": false }
      ],
      "timeout": 30
    }
  ],
  "runtime": { "type": "binary" }
}
